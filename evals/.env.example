# Copy to .env (gitignored). Only the keys for the targets you run are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Codex does not report cost, so prices (USD per million tokens) are needed to
# include Codex runs in cost totals and --max-cost. Leave unset to report Codex cost as unknown.
CODEX_PRICE_INPUT_PER_MTOK=
CODEX_PRICE_CACHED_INPUT_PER_MTOK=
CODEX_PRICE_OUTPUT_PER_MTOK=
