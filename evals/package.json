{
  "name": "io-intelligence-evals",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "tsx src/cli.ts run",
    "eval:approve": "tsx src/cli.ts approve",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.contracts.json",
    "format": "prettier --write src test *.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@anthropic-ai/sdk": "^1.3.0",
    "@openai/codex-sdk": "^0.166.0",
    "dotenv": "^18.0.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
